@startuml
!theme plain
title Orden de reconstruccion y dependencias - Practica 9\n(rojo = manual, azul = Terraform, verde = ArgoCD, amarillo = script, gris = capa persistente)
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam rectangle {
  RoundCorner 8
}

package "CAPA PERSISTENTE - rg-sa-p9-backend (fuera del cluster, NO se destruye)" as P #EEEEEE {
  database "Estado Terraform\nBlob tfstate + lock" as TFSTATE
  database "Blob stp9velero201901385/velero\nrespaldos Velero + repo Kopia" as BLOB
  database "Key Vault kv-p9-201901385\nllaves de Sealed Secrets" as KV
  database "GitHub publico\nrepo GitOps (rama p9) + repo de codigo" as GIT
}

package "FASE 0 - MANUAL (unico paso humano)" as F0 #FFD6D6 {
  rectangle "az login" as LOGIN
  rectangle "P9/scripts/bootstrap.ps1\n(punto de entrada unico)" as RUN
}

package "FASE 1 - AUTOMATICO: terraform apply" as F1 #D6E9FF {
  rectangle "terraform init\nbackend remoto con bloqueo" as INIT
  rectangle "Resource group rg-sa-p9" as RG
  rectangle "Cluster AKS aks-sa-p9 (2 nodos)" as AKS
  rectangle "Rol AcrPull" as ACR
  rectangle "ArgoCD (Helm)" as ARGO
  rectangle "Secret con llaves Sealed Secrets\nen kube-system" as KEYS
  rectangle "Velero (Helm) + schedule\nvelero-p9-platform cada 6 h" as VEL
  rectangle "Application p9-root-app\n(app-of-apps, ns argocd)" as ROOT
}

package "FASE 2 - AUTOMATICO: ArgoCD sincroniza apps/ por olas" as F2 #D8F5D8 {
  rectangle "OLA 0 (paralelo)\nsealed-secrets, argo-rollouts, kyverno" as W0
  rectangle "OLA 1\np8-kyverno-policies" as W1
  rectangle "OLA 2\nsa-platform-dev\n(microservicios, PostgreSQL, RabbitMQ,\nSealedSecret, Rollout gateway)" as W2
  rectangle "Controlador descifra el SealedSecret\ncon la llave restaurada" as DEC
}

package "FASE 3 - AUTOMATICO: mismo comando (bootstrap.ps1)" as F3 #FFF3C4 {
  rectangle "Espera apps Synced/Healthy,\nSealedSecret Synced, pods Ready" as WAIT
  rectangle "restore-datos.ps1\npausa GitOps -> borra STS/PVC vacios ->\nVelero Restore -> PodVolumeRestore -> reactiva GitOps" as RST
  rectangle "verificar.ps1\nGitOps, secretos, Velero, Rollout,\nKyverno bloquea :latest, gateway, datos" as VER
}

LOGIN --> RUN
RUN ==> INIT
INIT --> RG
RG --> AKS
AKS --> ACR
AKS --> ARGO
ARGO --> KEYS
ARGO --> VEL
KEYS --> ROOT
VEL --> ROOT
ROOT ==> W0
W0 --> W1
W1 --> W2
W2 --> DEC
DEC ==> WAIT
WAIT --> RST
RST --> VER

TFSTATE ..> INIT : lee/escribe estado
KV ..> KEYS : lee llaves
BLOB ..> VEL : destino de respaldos
BLOB ..> RST : origen de la restauracion
GIT ..> W0 : lee manifiestos
KEYS ..> DEC : el controlador las carga\nal arrancar

note bottom of F2
  Dependencia clave: las llaves deben estar en kube-system ANTES de que
  arranque el controlador; si no, genera una llave nueva y el SealedSecret
  del repositorio queda ilegible.
end note

note bottom of F3
  Dependencia clave: la politica Kyverno p8-require-non-root exime al
  initContainer "restore-wait" de Velero; sin eso el pod restaurado es
  rechazado y el volumen queda vacio.
end note
@enduml
